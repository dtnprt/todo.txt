{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todo.txt",
  "version": "0.1.69",
  "identifier": "dev.todotxt.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "todo.txt",
        "width": 1100,
        "height": 800,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../themes/*.css": "themes/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
